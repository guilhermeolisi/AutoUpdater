<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <!-- Application code with flow-sensitive null guards the compiler can't fully track -->
    <NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
    <!-- Publicado com Native AOT (perfis win-x64/arm64) ou trimming (demais).
         Sem dependências de BaseLibrary: o updater é autossuficiente e AOT-safe. -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
	<PropertyGroup>
		<AssemblyVersion>1.1.0.0</AssemblyVersion>
	</PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoUpdateModel\AutoUpdaterModel.csproj" />
  </ItemGroup>

</Project>
